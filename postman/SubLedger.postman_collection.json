{
  "info": {
    "_postman_id": "40e57245-0231-4979-a62d-668215e4a315",
    "name": "SubLedger",
    "description": "Postman collection for the implemented dger API. Run requests in order to create a plan, customer, subscription, invoice, and payment. The default local setup assumes DEBUG=true and requires no authentication. If DEBUG=false, configure Basic or Session authentication in Postman.\n\nRoute differences from the supplied API reference: subscription cancellation is POST /api/subscriptions/{id}/cancel/; payment recording is POST /api/payments/; customer-specific ledger history is not implemented, so this collection uses GET /api/ledger/ for the global ledger list.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "58538660"
  },
  "item": [
    {
      "name": "Plans",
      "item": [
        {
          "name": "Create plan",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Plan created', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('planId', String(body.id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"dger API Plan {{$timestamp}}\",\n  \"description\": \"Monthly subscription plan created from Postman\",\n  \"billing_cycle\": \"monthly\",\n  \"price\": \"49.00\",\n  \"currency\": \"USD\",\n  \"status\": \"active\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/plans/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "plans",
                ""
              ]
            },
            "description": "Creates a plan and stores its ID in the planId collection variable."
          },
          "response": []
        },
        {
          "name": "List plans",
